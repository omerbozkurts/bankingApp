# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgresql+asyncpg://abbank:abbank_dev@localhost:5434/abbank
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Key for hashing T.C. identity numbers; generate like JWT_SECRET and never change it.
NATIONAL_ID_PEPPER=change-me-too
JWT_EXPIRE_MINUTES=30
CORS_ORIGINS=["http://localhost:8081"]
# Bankacılık asistanı (Claude). Boş bırakılırsa ANTHROPIC_API_KEY ortam değişkeni veya
# `ant auth login` profili kullanılır; hiçbiri yoksa /assistant/chat 503 döner.
# ANTHROPIC_API_KEY=sk-ant-...
